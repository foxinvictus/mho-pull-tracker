rules_version = '2';
// Pull-Rechner · Monster Hunter Outlands
// In der Firebase-Konsole unter Firestore Database → Regeln komplett ersetzen und „Veröffentlichen“ klicken.
// Jeder Spieler darf nur sein eigenes Dokument lesen, schreiben und löschen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'data', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.data is string && request.resource.data.data.size() < 300000
        && request.resource.data.updatedAt is number;
    }
  }
}
